<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>SeedPlacement.Android</RootNamespace>
    <ApplicationId>com.nicrichard.seedplacement</ApplicationId>
    <ApplicationTitle>Seed Placement</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Released APKs carry only the ARM build every current phone runs; emulators also need x64. -->
    <RuntimeIdentifiers Condition="'$(PhoneRelease)' == 'true'">android-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SeedPlacement.App\SeedPlacement.App.csproj" />
  </ItemGroup>
</Project>
